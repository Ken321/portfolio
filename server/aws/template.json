{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "321ken voice: Lambda URL, durable admission, delayed cleanup. No API keys in template.",
  "Parameters": {
    "CodeBucket": {
      "Type": "String"
    },
    "CodeKey": {
      "Type": "String"
    },
    "ApiKeyParameter": {
      "Type": "String",
      "Default": "/321ken/voice/openai-api-key",
      "AllowedPattern": "/[a-zA-Z0-9_./-]+"
    },
    "AllowedOrigins": {
      "Type": "String",
      "Default": "https://321ken.com"
    },
    "DailyLimit": {
      "Type": "Number",
      "Default": 20,
      "MinValue": 1,
      "MaxValue": 100
    },
    "VoiceEnabled": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "true",
        "false"
      ]
    },
    "NotificationEmail": {
      "Type": "String",
      "Default": "",
      "Description": "Optional email recipient for cleanup failure notifications"
    }
  },
  "Resources": {
    "Calls": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "pk",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "pk",
            "KeyType": "HASH"
          }
        ],
        "TimeToLiveSpecification": {
          "AttributeName": "expiresAt",
          "Enabled": true
        }
      },
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain"
    },
    "DeadLetters": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "MessageRetentionPeriod": 1209600,
        "SqsManagedSseEnabled": true
      }
    },
    "CleanupQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "VisibilityTimeout": 180,
        "MessageRetentionPeriod": 86400,
        "SqsManagedSseEnabled": true,
        "RedrivePolicy": {
          "deadLetterTargetArn": {
            "Fn::GetAtt": [
              "DeadLetters",
              "Arn"
            ]
          },
          "maxReceiveCount": 5
        }
      }
    },
    "ApiRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "VoiceAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:PutItem",
                    "dynamodb:DeleteItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Calls",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ssm:GetParameter"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter${ApiKeyParameter}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "ApiLogs",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:SendMessage"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "CleanupQueue",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "ApiLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-api"
        },
        "RetentionInDays": 14
      }
    },
    "Api": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-api"
        },
        "Runtime": "nodejs22.x",
        "Architectures": [
          "arm64"
        ],
        "Handler": "runtime.api",
        "MemorySize": 256,
        "Timeout": 60,
        "ReservedConcurrentExecutions": 4,
        "Role": {
          "Fn::GetAtt": [
            "ApiRole",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "CodeBucket"
          },
          "S3Key": {
            "Ref": "CodeKey"
          }
        },
        "Environment": {
          "Variables": {
            "TABLE_NAME": {
              "Ref": "Calls"
            },
            "QUEUE_URL": {
              "Ref": "CleanupQueue"
            },
            "API_KEY_PARAMETER": {
              "Ref": "ApiKeyParameter"
            },
            "VOICE_ALLOWED_ORIGINS": {
              "Ref": "AllowedOrigins"
            },
            "VOICE_ENABLED": {
              "Ref": "VoiceEnabled"
            },
            "VOICE_DAILY_CALL_LIMIT": {
              "Ref": "DailyLimit"
            },
            "OPENAI_REALTIME_MODEL": "gpt-realtime-2.1-mini",
            "OPENAI_REALTIME_VOICE": "echo"
          }
        }
      }
    },
    "CleanupRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "VoiceAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:UpdateItem",
                    "dynamodb:PutItem",
                    "dynamodb:DeleteItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Calls",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "ssm:GetParameter"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter${ApiKeyParameter}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "CleanupLogs",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:ReceiveMessage",
                    "sqs:DeleteMessage",
                    "sqs:GetQueueAttributes"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "CleanupQueue",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "CleanupLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-cleanup"
        },
        "RetentionInDays": 14
      }
    },
    "Cleanup": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-cleanup"
        },
        "Runtime": "nodejs22.x",
        "Architectures": [
          "arm64"
        ],
        "Handler": "runtime.worker",
        "MemorySize": 256,
        "Timeout": 30,
        "ReservedConcurrentExecutions": 2,
        "Role": {
          "Fn::GetAtt": [
            "CleanupRole",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "CodeBucket"
          },
          "S3Key": {
            "Ref": "CodeKey"
          }
        },
        "Environment": {
          "Variables": {
            "TABLE_NAME": {
              "Ref": "Calls"
            },
            "QUEUE_URL": {
              "Ref": "CleanupQueue"
            },
            "API_KEY_PARAMETER": {
              "Ref": "ApiKeyParameter"
            },
            "VOICE_ALLOWED_ORIGINS": {
              "Ref": "AllowedOrigins"
            },
            "VOICE_ENABLED": {
              "Ref": "VoiceEnabled"
            },
            "VOICE_DAILY_CALL_LIMIT": {
              "Ref": "DailyLimit"
            },
            "OPENAI_REALTIME_MODEL": "gpt-realtime-2.1-mini",
            "OPENAI_REALTIME_VOICE": "echo"
          }
        }
      }
    },
    "ApiUrl": {
      "Type": "AWS::Lambda::Url",
      "Properties": {
        "TargetFunctionArn": {
          "Ref": "Api"
        },
        "AuthType": "NONE"
      }
    },
    "UrlPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunctionUrl",
        "FunctionName": {
          "Ref": "Api"
        },
        "Principal": "*",
        "FunctionUrlAuthType": "NONE"
      }
    },
    "InvokePermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "Api"
        },
        "Principal": "*",
        "InvokedViaFunctionUrl": true
      }
    },
    "CleanupMapping": {
      "Type": "AWS::Lambda::EventSourceMapping",
      "Properties": {
        "EventSourceArn": {
          "Fn::GetAtt": [
            "CleanupQueue",
            "Arn"
          ]
        },
        "FunctionName": {
          "Ref": "Cleanup"
        },
        "BatchSize": 1,
        "FunctionResponseTypes": [
          "ReportBatchItemFailures"
        ],
        "ScalingConfig": {
          "MaximumConcurrency": 2
        },
        "Enabled": true
      }
    },
    "CleanupAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "Voice cleanup exhausted retries. Investigate DLQ and call rows; do not release active slots blindly.",
        "Namespace": "AWS/SQS",
        "MetricName": "ApproximateNumberOfMessagesVisible",
        "Dimensions": [
          {
            "Name": "QueueName",
            "Value": {
              "Fn::GetAtt": [
                "DeadLetters",
                "QueueName"
              ]
            }
          }
        ],
        "Statistic": "Maximum",
        "Period": 60,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": {
          "Fn::If": [
            "HasNotificationEmail",
            [
              {
                "Ref": "AlarmTopic"
              }
            ],
            []
          ]
        }
      }
    },
    "AlarmTopic": {
      "Type": "AWS::SNS::Topic",
      "Condition": "HasNotificationEmail",
      "Properties": {
        "DisplayName": "Portfolio voice alerts"
      }
    },
    "AlarmSubscription": {
      "Type": "AWS::SNS::Subscription",
      "Condition": "HasNotificationEmail",
      "Properties": {
        "TopicArn": {
          "Ref": "AlarmTopic"
        },
        "Protocol": "email",
        "Endpoint": {
          "Ref": "NotificationEmail"
        }
      }
    }
  },
  "Outputs": {
    "ApiBaseUrl": {
      "Value": {
        "Fn::GetAtt": [
          "ApiUrl",
          "FunctionUrl"
        ]
      }
    },
    "CleanupQueueUrl": {
      "Value": {
        "Ref": "CleanupQueue"
      }
    },
    "DeadLetterQueueUrl": {
      "Value": {
        "Ref": "DeadLetters"
      }
    },
    "CallsTable": {
      "Value": {
        "Ref": "Calls"
      }
    },
    "CleanupAlarmName": {
      "Value": {
        "Ref": "CleanupAlarm"
      }
    }
  },
  "Conditions": {
    "HasNotificationEmail": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "NotificationEmail"
            },
            ""
          ]
        }
      ]
    }
  }
}
